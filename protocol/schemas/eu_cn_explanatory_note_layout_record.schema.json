{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EU CN Explanatory Note Layout Record",
  "type": "object",
  "required": [
    "record_id",
    "chapter",
    "heading_code",
    "cn_code",
    "code_range",
    "title",
    "note_text",
    "page",
    "pages",
    "source_bbox",
    "source_blocks",
    "source_excerpt",
    "source_engine",
    "review_flags"
  ],
  "properties": {
    "record_id": {"type": "string"},
    "chapter": {"type": ["string", "null"]},
    "heading_code": {"type": ["string", "null"]},
    "cn_code": {"type": ["string", "null"]},
    "code_range": {
      "type": ["object", "null"],
      "required": ["start", "end", "connector"],
      "properties": {
        "start": {"type": "string"},
        "end": {"type": ["string", "null"]},
        "connector": {"type": ["string", "null"], "enum": ["to", "and", null]}
      }
    },
    "title": {"type": "string"},
    "note_text": {"type": "string"},
    "page": {"type": "integer", "minimum": 1},
    "pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "source_bbox": {
      "type": "object",
      "required": ["code_column", "text_column"],
      "properties": {
        "code_column": {"type": "array", "minItems": 4, "maxItems": 4},
        "text_column": {"type": ["array", "null"], "minItems": 4, "maxItems": 4}
      }
    },
    "source_blocks": {"type": "array", "minItems": 1},
    "source_excerpt": {"type": "string"},
    "source_engine": {
      "type": "object",
      "required": ["layout", "ocr_text"],
      "properties": {
        "layout": {"const": "pymupdf"},
        "ocr_text": {"const": "mistral_ocr"}
      }
    },
    "review_flags": {"type": "array", "items": {"type": "string"}}
  }
}
